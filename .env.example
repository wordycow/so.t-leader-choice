# 🔧 환경 변수 설정
# ChatGPT API 연동을 위한 설정 파일

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# OpenAI API 키 (필수!)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=YOUR_API_KEY_HERE

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 모델 선택
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# gpt-4: 최고 품질 (비싸고 느림)
# gpt-4-turbo-preview: 빠른 GPT-4
# gpt-3.5-turbo: 빠르고 저렴 (추천!)
OPENAI_MODEL=gpt-3.5-turbo

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AI 백엔드 선택
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# local: 로컬 AI (Ollama) 사용 (무료!)
# openai: OpenAI API 직접 사용
AI_BACKEND=local

# 로컬 AI (Ollama) 설정
LOCAL_AI_HOST=https://infinite-keno-casinos-constantly.trycloudflare.com
LOCAL_AI_MODEL=qwen2.5:7b

# 자동 폴백 (로컬 AI 실패 시 OpenAI 사용)
AUTO_FALLBACK=true

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# API 키 발급 방법
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 1. https://platform.openai.com 접속
# 2. 계정 로그인 (구글 계정 연동 가능)
# 3. "API Keys" 메뉴 선택
# 4. "Create new secret key" 클릭
# 5. 생성된 키를 복사하여 위의 OPENAI_API_KEY에 입력
# 
# 예시: OPENAI_API_KEY=sk-proj-abc123xyz...
# 
# ⚠️ 주의: API 키는 절대 공개하지 마세요!

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 비용 참고 (2024년 기준)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GPT-3.5-turbo:
#   - 입력: $0.001/1K tokens
#   - 출력: $0.002/1K tokens
#   - 1회 대화 평균: $0.001 (약 1.3원)
#   - 1,000회 대화: $1 (약 1,300원)
# 
# GPT-4:
#   - 입력: $0.03/1K tokens
#   - 출력: $0.06/1K tokens
#   - 1회 대화 평균: $0.03 (약 40원)
#   - 1,000회 대화: $30 (약 40,000원)
# 
# 💡 추천: GPT-3.5-turbo 사용 (가성비 최고!)
