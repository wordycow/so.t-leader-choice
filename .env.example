# ⚠️ .env 파일 템플릿
# 이 파일을 복사해서 .env 파일을 만들고, 실제 API 키를 입력하세요.
# 
# 사용 방법:
# 1. 이 파일을 복사: cp .env.example .env
# 2. .env 파일 편집: nano .env
# 3. 아래 YOUR_ACCESS_KEY와 YOUR_SECRET_KEY를 실제 값으로 변경
# 4. 저장 후 봇 실행
#
# ⚠️ 주의: .env 파일은 절대 Git에 올리지 마세요!

# 업비트 API 키 (https://upbit.com/mypage/open_api_management 에서 발급)
UPBIT_ACCESS_KEY=YOUR_ACCESS_KEY_HERE
UPBIT_SECRET_KEY=YOUR_SECRET_KEY_HERE
