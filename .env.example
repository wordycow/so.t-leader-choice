# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# AI 백엔드 설정
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# AI 백엔드 선택: 'local' (Ollama) or 'openai'
AI_BACKEND=local

# 로컬 AI (Ollama) 설정
LOCAL_AI_HOST=72.14.201.167  # ← 노트북 IP 주소 (확인 완료!)
LOCAL_AI_PORT=11434
LOCAL_AI_MODEL=qwen2.5:7b

# 자동 폴백 (로컬 AI 실패 시 OpenAI 사용)
AUTO_FALLBACK=true

# OpenAI 설정 (백업용)
OPENAI_API_KEY=your_openai_api_key_here

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# GenSpark 통합
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

GENSPARK_VIDEO_ENABLED=true
GENSPARK_AUDIO_ENABLED=true
GENSPARK_IMAGE_ENABLED=true
GENSPARK_SEARCH_ENABLED=true
