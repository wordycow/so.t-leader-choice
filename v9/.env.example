# ====================================
# Upbit Bot v9 Environment Configuration
# ====================================

# --- TRADING MODE ---
# Set to 'true' to enable real trading (requires /enable_live.flag file)
# Default: false (practice mode)
ENABLE_REAL_TRADING=false

# --- UPBIT API CREDENTIALS ---
# Get your keys from: https://upbit.com/mypage/open_api_management
UPBIT_ACCESS_KEY=your_access_key_here
UPBIT_SECRET_KEY=your_secret_key_here

# --- OLLAMA AI CONFIGURATION ---
# Local AI endpoint for IMEI chat (default: localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# --- WEBSOCKET CONFIGURATION ---
# Signal Engine → Execution Engine communication
SIGNAL_WS_HOST=0.0.0.0
SIGNAL_WS_PORT=8765

# --- SAFETY LIMITS ---
# First phase exposure limit (KRW)
FIRST_PHASE_EXPOSURE_LIMIT=100000

# Daily drawdown limit (%)
DAILY_DRAWDOWN_LIMIT_PCT=2.0

# --- CAPITAL RULES ---
# % of equity per trade
CAPITAL_PER_TRADE_PCT=10.0

# Maximum concurrent positions
MAX_CONCURRENT_TRADES=2

# Total portfolio allocation limit (%)
MAX_TOTAL_ALLOCATION_PCT=20.0

# --- BTC STACKING ---
# Minimum profit to trigger BTC purchase (KRW)
BTC_STACK_MIN_PROFIT=10000

# --- DATABASE ---
# SQLite database path
DB_PATH=upbit_bot.db

# --- LOGGING ---
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- DASHBOARD ---
# Flask dashboard port
DASHBOARD_PORT=5000

# --- ADVANCED ---
# RAG database similarity threshold
RAG_SIMILARITY_THRESHOLD=0.4

# RAG top-k results
RAG_TOP_K=4

# ====================================
# IMPORTANT NOTES:
# ====================================
# 1. Copy this file to .env and fill in your credentials
# 2. Never commit .env to git (already in .gitignore)
# 3. Real trading requires BOTH:
#    - ENABLE_REAL_TRADING=true
#    - /enable_live.flag file exists
# 4. First phase is limited to 100,000 KRW exposure
# 5. Daily -2% drawdown triggers circuit breaker
# ====================================
